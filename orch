#!/bin/sh
here=$(cd "$(dirname "$0")" && pwd)
python="$here/.venv/bin/python"
if [ ! -x "$python" ]; then
    echo "Brak interpretera: $python" >&2
    echo "Utwórz środowisko: python3 -m venv .venv w katalogu projektu" >&2
    exit 1
fi
cd "$here/orchestrator" && exec "$python" -m orchestrator "$@"
